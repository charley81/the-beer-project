---
import { Font } from 'astro:assets'
import MainNav from '../components/main-nav/main-nav.astro'
import { ClientRouter } from 'astro:transitions'
import { Toaster } from '@/components/ui/sonner'
import '../styles/global.css'
import '../styles/snipcart-theme.css'

interface Props {
  title: string
  description?: string
  image?: string
  transparentNav?: boolean
  fixed?: boolean
}

const {
  title,
  description = 'A personal beer project by Christopher Harley',
  image = '/favicon.svg',
  transparentNav = false,
  fixed = false,
} = Astro.props

const canonicalURL = new URL(Astro.url.pathname, Astro.site)
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalURL} />
    <title>{title} | The Beer Project</title>
    <meta name="title" content={`${title} | The Beer Project`} />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.url)} />
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, Astro.url)} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="The Beer Project RSS Feed"
      href={`${Astro.site}rss.xml`}
    />
    <Font cssVariable="--font-fredoka" />
    <ClientRouter />

    <link rel="preconnect" href="https://app.snipcart.com" />
    <link rel="preconnect" href="https://cdn.snipcart.com" />
    <link
      rel="stylesheet"
      href="https://cdn.snipcart.com/themes/v3.0.31/default/snipcart.css"
    />
    <script
      is:inline
      define:vars={{ apiKey: import.meta.env.PUBLIC_SNIPCART_API_KEY }}
    >
      window.SnipcartSettings = {
        publicApiKey: apiKey || '',
        loadStrategy: 'on-user-interaction',
        modalStyle: 'side',
        addProductBehavior: 'none',
      }

      // Ensure the key is set on the div even if it was missing at build time
      document.addEventListener('DOMContentLoaded', () => {
        const snipcartDiv = document.getElementById('snipcart')
        if (
          snipcartDiv &&
          !snipcartDiv.getAttribute('data-api-key') &&
          window.SnipcartSettings.publicApiKey
        ) {
          snipcartDiv.setAttribute(
            'data-api-key',
            window.SnipcartSettings.publicApiKey,
          )
        }
      })
    </script>
    <script
      async
      src="https://cdn.snipcart.com/themes/v3.0.31/default/snipcart.js"
    ></script>
  </head>

  <body
    class:list={[
      'bg-background text-foreground antialiased font-sans tracking-wide min-h-screen flex flex-col',
      fixed && 'h-screen overflow-hidden',
    ]}
  >
    <MainNav transparent={transparentNav} />
    <Toaster client:load position="top-center" richColors />

    <main
      class:list={[
        'grow flex flex-col w-full min-h-0',
        fixed && 'overflow-hidden',
      ]}
    >
      <slot />
    </main>

    <div transition:persist="snipcart-wrapper">
      <div
        id="snipcart"
        hidden
        data-api-key={import.meta.env.PUBLIC_SNIPCART_API_KEY}
        data-config-modal-style="side"
        data-config-add-product-behavior="none"
      >
      </div>
    </div>
  </body>
</html>
