---
import { Badge } from '../ui/badge'
import { Beer, MapPin } from 'lucide-react'
import { type Brewery } from '@/lib/api/brewery'
import { FavoriteButton } from './favorite-button'

interface Props {
  brewery: Brewery
  isFavorited?: boolean
}

const { brewery: b, isFavorited = false } = Astro.props

const GOOGLE_MAPS_API_KEY = import.meta.env.PUBLIC_GOOGLE_MAPS_API_KEY

/**
 * We use the brewery name + address for the 'q' parameter.
 * This is the most reliable way to get a 'Place' marker in the Embed API.
 */
const address =
  `${b.street || ''} ${b.city}, ${b.state_province || b.state} ${b.postal_code || ''}`.trim()
const mapQuery = `${b.name}, ${address}`

const mapUrl = `https://www.google.com/maps/embed/v1/place?key=${GOOGLE_MAPS_API_KEY}&q=${encodeURIComponent(mapQuery)}`
---

<section class="relative h-125 md:h-150 w-full overflow-hidden bg-muted">
  <!-- Map Layer (Interactable) -->
  <div class="absolute inset-0 z-0">
    {
      GOOGLE_MAPS_API_KEY ? (
        <iframe
          width="100%"
          height="100%"
          style="border:0"
          loading="lazy"
          allowfullscreen
          title={`Map of ${b.name}`}
          class="grayscale-[0.4] contrast-[1.1] brightness-[0.9] transition-opacity duration-700"
          src={mapUrl}
        />
      ) : (
        <div class="flex h-full w-full items-center justify-center bg-secondary/50">
          <p class="text-sm text-muted-foreground italic">
            Map preview unavailable
          </p>
        </div>
      )
    }
  </div>

  <!-- Content Overlay / Gradient (Pointer events disabled to allow map clicks) -->
  <div
    class="absolute inset-0 z-10 bg-linear-to-t from-background via-background/40 to-transparent pointer-events-none"
  >
    <div class="container mx-auto flex h-full flex-col justify-end pb-24 px-4">
      <div class="max-w-4xl space-y-6">
        <div class="flex items-center justify-between pointer-events-auto">
          <div class="flex items-center gap-3">
            <Badge
              variant="outline"
              className="bg-primary/20 text-primary-foreground border-primary/30 backdrop-blur-md px-4 py-1.5 text-xs font-bold uppercase tracking-widest flex items-center gap-2 shadow-lg"
            >
              <Beer className="w-3.5 h-3.5" />
              {b.brewery_type.replace(/_/g, ' ')}
            </Badge>
          </div>

          <FavoriteButton
            client:load
            breweryId={b.id}
            initialIsFavorited={isFavorited}
            className="bg-background/20 backdrop-blur-md border border-white/10 shadow-xl"
          />
        </div>

        <div class="space-y-4">
          <h1
            class="text-5xl md:text-7xl font-bold tracking-tight text-foreground leading-[1.1] drop-shadow-md animate-in fade-in slide-in-from-bottom-4 duration-700"
          >
            {b.name}
          </h1>

          <div
            class="flex items-center gap-2.5 text-muted-foreground text-xl md:text-2xl font-medium animate-in fade-in slide-in-from-bottom-2 duration-700 delay-150"
          >
            <MapPin className="w-6 h-6 text-primary" />
            <span class="drop-shadow-sm"
              >{b.city}, {b.state_province || b.state}</span
            >
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
