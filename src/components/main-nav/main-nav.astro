---
import { NavMenu } from './nav-menu'
import { auth } from '../../lib/auth'

interface Props {
  transparent?: boolean
}

const { transparent = false } = Astro.props
const { session } = Astro.locals
const pathname = Astro.url.pathname
---

<nav
  id="main-nav"
  data-transparent={transparent ? 'true' : 'false'}
  class={`z-50 w-full px-4 py-8 transition-all duration-300 ${
    transparent ? 'absolute top-0 left-0' : 'sticky top-0'
  }`}
>
  <div class="mx-auto flex max-w-(--width-max-lg) items-center justify-between">
    <a href="/" class="transition-opacity hover:opacity-80">
      <h3 class="text-3xl font-black">
        The <span class="text-primary">Beer</span> Project
      </h3>
    </a>
    <NavMenu
      client:load
      session={session}
      pathname={pathname}
      transition:persist
    />
  </div>
</nav>

<script>
  const handleScroll = () => {
    const nav = document.getElementById('main-nav')
    const isTransparent = nav?.getAttribute('data-transparent') === 'true'

    if (window.scrollY > 20) {
      nav?.setAttribute('data-scrolled', 'true')
      if (isTransparent) {
        nav?.classList.add('sticky')
        nav?.classList.remove('absolute')
      }
    } else {
      nav?.removeAttribute('data-scrolled')
      if (isTransparent) {
        nav?.classList.add('absolute')
        nav?.classList.remove('sticky')
      }
    }
  }

  window.addEventListener('scroll', handleScroll, { passive: true })
  handleScroll()
  document.addEventListener('astro:after-swap', handleScroll)
</script>

<style>
  /* Base state: Solid Theme Charcoal */
  nav {
    background-color: var(--color-nav);
    color: var(--color-nav-fg);
  }

  /* Scrolled state: Theme Charcoal + 80% Opacity + Glassmorphism */
  nav[data-scrolled='true'] {
    background-color: oklch(0.141 0.005 285.823 / 0.8);
    backdrop-filter: blur(12px);
    padding-top: 1rem;
    padding-bottom: 1rem;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
    border-bottom: 1px solid oklch(1 0 0 / 0.1);
  }

  /* Hero state: Theme Charcoal + 40% Opacity + Shadow for legibility */
  nav[data-transparent='true']:not([data-scrolled='true']) {
    background-color: oklch(0.141 0.005 285.823 / 0.4);
    background-image: linear-gradient(
      to bottom,
      oklch(0.141 0.005 285.823 / 0.9) 0%,
      oklch(0.141 0.005 285.823 / 0) 100%
    );
    color: white;
  }
</style>
