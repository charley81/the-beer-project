---
const { class: className } = Astro.props

// Check if className already contains a max-w class to avoid duplication/conflicts
const hasMaxWidth = className?.includes('max-w-')
---

<section 
  class:list={[
    'mx-auto w-full px-4 pt-12', 
    !hasMaxWidth && 'max-w-(--width-max-md)',
    className
  ]}
>
  <slot />
</section>
