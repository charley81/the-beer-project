---
import { auth } from '../lib/auth'
import { UserMenu } from './user-menu'

const session = await auth.api.getSession({
  headers: Astro.request.headers,
})

const user = session?.user
---

<nav class="p-8 bg-yellow-500 text-yellow-950 font-bold w-full">
  <div class="flex max-w-(--width-max-lg) mx-auto justify-between">
    <a href="/">
      <h3 class="text-3xl">The Beer Project</h3>
    </a>
    <ul class="flex gap-4">
      <a href="/">home</a>
      <a href="/about">about</a>
      <a href="/contact">contact</a>
      <a href="/blog">blog</a>
      <a href="/store">store</a>
    </ul>
    <UserMenu client:load />
  </div>
</nav>

<script>
  // Add logout functionality using the auth-client
  import { signOut } from '../lib/auth-client'

  const logoutBtn = document.getElementById('logout-btn')
  logoutBtn?.addEventListener('click', async () => {
    await signOut({
      fetchOptions: {
        onSuccess: () => {
          window.location.href = '/' // Redirect home after logout
        },
      },
    })
  })
</script>
