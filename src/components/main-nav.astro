---
import { UserMenu } from './user-menu'
import { auth } from '../lib/auth'

const session = await auth.api.getSession({
  headers: Astro.request.headers,
})
---

<nav class="p-8 bg-yellow-500 text-yellow-950 font-bold w-full">
  <div class="flex max-w-(--width-max-lg) mx-auto justify-between items-center">
    <a href="/">
      <h3 class="text-3xl">The Beer Project</h3>
    </a>
    <ul class="flex gap-4">
      <a href="/">home</a>
      <a href="/about">about</a>
      <a href="/contact">contact</a>
      <a href="/blog">blog</a>
      <a href="/store">store</a>
    </ul>
    <div class="flex justify-end w-48">
      <UserMenu client:load initialSession={session} />
    </div>
  </div>
</nav>
