---
import { products } from '@/data/products'
import BaseLayout from '../../layouts/base-layout.astro'
import Section from '@/components/base/section.astro'
import { StoreButton } from '@/components/ui/store-button'
import { ShoppingCart } from 'lucide-react'

export async function getStaticPaths() {
  return products.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }))
}

const { product } = Astro.props
---

<BaseLayout title={product.name}>
  <Section className="py-12">
    <div
      class="grid grid-cols-1 md:grid-cols-2 gap-4 items-start max-w-6xl mx-auto"
    >
      <div class="relative group">
        <img
          src={product.image}
          alt={product.name}
          class="rounded-3xl shadow-2xl w-full object-cover aspect-square border border-border/50"
        />
        <div
          class="absolute top-4 right-4 bg-background/80 backdrop-blur-md px-3 py-1 rounded-full border border-border font-bold"
        >
          ${product.price}
        </div>
      </div>

      <div class="space-y-6">
        <div class="space-y-2">
          <h1 class="text-5xl font-black italic tracking-tighter">
            {product.name}
          </h1>
          <p class="text-lg font-medium text-muted-foreground">
            {product.description}
          </p>
        </div>

        <div class="prose prose-stone dark:prose-invert">
          <p>{product.details}</p>
        </div>

        <StoreButton
          client:load
          product={product}
          url={Astro.url.toString()}
          className="w-full bg-primary text-primary-foreground py-6 rounded-full font-black text-lg hover:shadow-lg hover:shadow-primary/20 transition-all flex items-center justify-center gap-3 active:scale-95"
        >
          <ShoppingCart className="w-5 h-5" /> Add to Cart - ${product.price}
        </StoreButton>

        <div class="pt-6 border-t border-border/50">
          <p
            class="text-xs text-muted-foreground uppercase tracking-widest font-black"
          >
            Professional Brewing Equipment
          </p>
        </div>
      </div>
    </div>
  </Section>
</BaseLayout>
