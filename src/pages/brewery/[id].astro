---
export const prerender = false

import BaseLayout from '@/layouts/base-layout.astro'
import { getBreweryById } from '@/lib/api/brewery'
import { Button } from '@/components/ui/button'
import BreweryHero from '@/components/brewery/brewery-hero.astro'
import BreweryDetails from '@/components/brewery/brewery-details.astro'
import { ArrowLeft } from 'lucide-react'

const { id } = Astro.params

if (!id) {
  return Astro.redirect('/search')
}

let brewery
try {
  brewery = await getBreweryById(id)
} catch (error) {
  console.error('Error fetching brewery:', error)
  return Astro.redirect('/404')
}
---

<BaseLayout title={`${brewery.name} | The Beer Project`}>
  <main class="space-y-12 pb-20">
    <BreweryHero brewery={brewery} />

    <div class="container mx-auto px-4 -mt-10 relative z-30">
      <div class="max-w-5xl mx-auto space-y-12">
        <div class="flex">
          <a 
            href="/search" 
            class="group flex items-center gap-3 text-sm font-bold tracking-tight text-foreground transition-colors hover:text-primary"
          >
            <div class="flex h-10 w-10 items-center justify-center rounded-full bg-primary text-primary-foreground transition-all duration-300 group-hover:bg-transparent group-hover:border-2 group-hover:border-primary group-hover:text-primary">
              <ArrowLeft
                className="w-5 h-5 transition-transform group-hover:-translate-x-1"
              />
            </div>
            <span>Back to Search</span>
          </a>
        </div>

        <BreweryDetails brewery={brewery} />

        <div class="border-t border-border/50 pt-12 text-center">
          <div
            class="inline-block p-1 px-3 rounded-full bg-secondary/50 text-[10px] uppercase tracking-widest font-bold text-muted-foreground mb-4"
          >
            Coming Soon
          </div>
          <p class="text-muted-foreground italic text-sm max-w-sm mx-auto">
            You'll soon be able to save your favorite breweries to your personal
            dashboard.
          </p>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>
