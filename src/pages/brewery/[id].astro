---
export const prerender = false

import BaseLayout from '@/layouts/base-layout.astro'
import { getBreweryById } from '@/lib/api/brewery'
import { Button } from '@/components/ui/button'
import BreweryHero from '@/components/brewery/brewery-hero.astro'
import BreweryDetails from '@/components/brewery/brewery-details.astro'
import Section from '@/components/base/section.astro'
import { ArrowLeft } from 'lucide-react'
import { isBreweryFavorited } from '@/lib/api/favorites'
import { auth } from '@/lib/auth'

const { id } = Astro.params

if (!id) {
  return Astro.redirect('/search')
}

const session = await auth.api.getSession({
  headers: Astro.request.headers,
})

let brewery
let isFavorited = false

try {
  brewery = await getBreweryById(id)

  if (session?.user) {
    isFavorited = await isBreweryFavorited(session.user.id, id)
  }
} catch (error) {
  console.error('Error fetching brewery or favorite status:', error)
  return Astro.redirect('/404')
}
---

<BaseLayout 
  title={`${brewery.name} | ${brewery.city}, ${brewery.state_province || brewery.state}`}
  description={`Visit ${brewery.name} in ${brewery.city}, ${brewery.state_province || brewery.state}. Get directions, contact info, and more.`}
>
  <main class="pb-20">
    <BreweryHero brewery={brewery} isFavorited={isFavorited} />

    <div class="container mx-auto px-4 -mt-10 relative z-30">
      <div class="max-w-5xl mx-auto space-y-12">
        <div class="flex">
          <a 
            href={`/search?city=${encodeURIComponent(brewery.city)}`}
            class="group flex items-center gap-3 text-sm font-bold tracking-tight text-foreground transition-colors hover:text-primary"
          >
            <div class="flex h-10 w-10 items-center justify-center rounded-full bg-primary text-primary-foreground transition-all duration-300 group-hover:bg-transparent group-hover:border-2 group-hover:border-primary group-hover:text-primary">
              <ArrowLeft
                className="w-5 h-5 transition-transform group-hover:-translate-x-1"
              />
            </div>
            <span>Back to Results</span>
          </a>
        </div>

        <BreweryDetails brewery={brewery} />

        <div class="border-t border-border/50 pt-12 text-center">
          <p class="text-muted-foreground italic text-sm max-w-sm mx-auto">
            Information provided by Open Brewery DB.
          </p>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>
