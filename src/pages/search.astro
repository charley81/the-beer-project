---
import PageHeader from '../components/page-header.astro'
import BaseLayout from '../layouts/base-layout.astro'
import Section from '@/components/base/section.astro'
import { BrewerySearch } from '@/components/brewery/brewery-search'
import { getBreweriesByCity } from '@/lib/api/brewery'
import { getFavoriteIdsForUser } from '@/lib/api/favorites'
import { auth } from '@/lib/auth'

const initialCity = Astro.url.searchParams.get('city') || ''
let initialData = null

if (initialCity && initialCity.trim().length >= 2) {
  try {
    const breweries = await getBreweriesByCity(initialCity)
    
    const session = await auth.api.getSession({
      headers: Astro.request.headers,
    })

    const favoriteIds = session?.user ? await getFavoriteIdsForUser(session.user.id) : []

    initialData = {
      data: { breweries, favoriteIds },
      error: null
    }
  } catch (e) {
    initialData = {
      data: { breweries: [], favoriteIds: [] },
      error: { message: 'Failed to load initial results.' }
    }
  }
}
---

<BaseLayout title="Search" fixed>
  <Section class="flex h-full flex-col overflow-hidden">
    <div class="flex-none">
      <PageHeader
        heading="Search"
        description="Find your next favorite pour from thousands of local breweries."
      />
    </div>
    <div class="min-h-0 flex-1">
      <BrewerySearch 
        client:load 
        initialCity={initialCity} 
        initialData={initialData}
      />
    </div>
  </Section>
</BaseLayout>
